  "packageManager": "npm@11.4.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && eslint . && npm run check:imports",
    "test": "vitest run",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "wasm": "node scripts/wasm.mjs",
    "wasm:check": "node scripts/wasm.mjs --check",
    "wasm:check:local": "node scripts/wasm.mjs --check --local",
    "check:imports": "node scripts/check-imports.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
